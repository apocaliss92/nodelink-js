{
  "name": "@reolink/baichuan-js",
  "version": "0.1.0",
  "description": "TypeScript library implementing Reolink Baichuan protocol (control + streaming) with CGI and RTSP helpers. Full TypeScript support with comprehensive type definitions.",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "reolink",
    "baichuan",
    "camera",
    "security",
    "ip-camera",
    "rtsp",
    "streaming",
    "typescript",
    "nvr"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npx tsup",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "lint": "npx eslint .",
    "test:build": "npm run build && npx tsc -p tsconfig.test.json",
    "test:tcp": "npm run test:build && node dist/test/tcp/test-tcp.js",
    "test:tcp:native": "npm run test:build && node dist/test/tcp/test-tcp-native-apis.js",
    "test:tcp:audio": "npm run test:build && node dist/test/tcp/test-tcp-audio.js",
    "test:tcp:streams": "npm run test:build && node dist/test/tcp/test-tcp-streams-record.js",
    "test:tcp:stream-analyze": "npm run test:build && node dist/test/tcp/test-tcp-stream-analyze.js",
    "test:tcp:stream-request": "npm run test:build && node dist/test/tcp/test-tcp-stream-request.js",
    "test:tcp:video-stream": "npm run test:build && node dist/test/tcp/test-tcp-video-stream.js",
    "test:tcp:video-stream-simple": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-simple.js",
    "test:tcp:video-stream-detailed": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-detailed.js",
    "test:tcp:video-stream-bcmedia": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-bcmedia.js",
    "test:tcp:video-stream-save-frames": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-save-frames.js",
    "test:tcp:video-stream-load-frames": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-load-frames.js",
    "test:tcp:video-stream-record": "npm run test:build && node dist/test/tcp/test-tcp-video-stream-record.js",
    "test:tcp:diagnostics": "npm run test:build && node dist/test/tcp/test-tcp-diagnostics-bundle.js",
    "test:tcp:video-save-merge": "npm run test:build && node dist/test/tcp/test-tcp-video-save-and-merge.js",
    "test:tcp:new-apis": "npm run test:build && node dist/test/tcp/test-tcp-new-apis.js",
    "test:tcp:ability-comparison": "npm run test:build && node dist/test/tcp/test-ability-comparison.js",
    "test:udp": "npm run test:build && node dist/test/udp/test-udp.js",
    "test:udp:record": "npm run test:build && node dist/test/udp/test-udp-video-stream-record.js",
    "test:streams": "npm run test:build && node dist/test/streams/test-streams.js",
    "test:nvr:tcp": "npm run test:build && node dist/test/nvr/test-nvr-tcp.js",
    "test:nvr:udp": "npm run test:build && node dist/test/nvr/test-nvr-udp.js",
    "test:nvr:streams": "npm run test:build && node dist/test/nvr/test-nvr-streams.js",
    "test:nvr:all": "npm run test:nvr:tcp && npm run test:nvr:udp && npm run test:nvr:streams",
    "test:all": "npm run test:tcp && npm run test:udp && npm run test:streams",
    "test:native": "npm run test:tcp:native"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "alawmulaw": "^6.0.0",
    "dotenv": "^17.2.3",
    "undici": "^7.16.0"
  }
}
