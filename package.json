{
  "name": "@apocaliss92/reolink-baichuan-js",
  "version": "0.1.1",
  "description": "TypeScript library implementing Reolink Baichuan protocol (control + streaming) with CGI and RTSP helpers. Full TypeScript support with comprehensive type definitions.",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/apocaliss92/reolink-baichuan-js.git"
  },
  "keywords": [
    "reolink",
    "baichuan",
    "camera",
    "security",
    "ip-camera",
    "rtsp",
    "streaming",
    "typescript",
    "nvr"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:js": "npx tsup",
    "build:types": "rm -rf .tmp/types && npx tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap false --outDir .tmp/types && npx api-extractor run --local && rm -rf .tmp/types",
    "build": "npm run build:js && npm run build:types",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "lint": "npx eslint .",
    "rtsp-server": "npm run build && node dist/cli/rtsp-server.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.53.0",
    "@types/node": "^24.0.0",
    "@types/yazl": "^2.4.6",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "alawmulaw": "^6.0.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^4.5.3",
    "jimp": "^1.6.0",
    "undici": "^7.16.0",
    "yazl": "^3.3.1"
  }
}
