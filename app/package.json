{
  "name": "nodelink-manager",
  "version": "0.4.2-beta.6",
  "description": "Web UI to manage Reolink cameras and RTSP streams",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:server": "tsup",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n server,client -c green,cyan \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "@camstack/ui-library": "^0.1.23",
    "@apocaliss92/nodelink-js": "file:..",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/server": "^10.45.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fast-deep-equal": "^3.1.3",
    "go2rtc-static": "^1.9.4",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.576.0",
    "mqtt": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "tailwindcss": "^4.2.2",
    "trpc-panel": "^1.3.4",
    "uuid": "^13.0.0",
    "werift": "^0.22.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0",
    "yaml": "^2.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsup": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.11"
  }
}
