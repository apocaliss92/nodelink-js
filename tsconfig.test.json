{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@apocaliss92/reolink-baichuan-js": ["./dist/index"],
      "../../index": ["./dist/index"]
    }
  },
  "include": ["test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

