# ============================================
# Configurazione Test Reolink Baichuan
# ============================================
# Copia questo file come .env e modifica i valori con le credenziali della tua videocamera
# 
# Comando per copiare:
#   cp env.template .env

# --------------------------------------------
# Configurazione TCP (videocamere cablate)
# --------------------------------------------
TCP_HOST=
TCP_USERNAME=admin
TCP_PASSWORD=

# --------------------------------------------
# Configurazione UDP (BCUDP - videocamere a batteria)
# --------------------------------------------
UDP_HOST=
UDP_USERNAME=admin
UDP_PASSWORD=
UDP_UID=

# --------------------------------------------
# Configurazione NVR (Home Hub)
# --------------------------------------------
NVR_HOST=
NVR_USERNAME=admin
NVR_PASSWORD=
NVR_UID=

# --------------------------------------------
# Configurazione RTSP Proxy Server
# --------------------------------------------
# Porta su cui il server RTSP proxy ascolterà
RTSP_PROXY_PORT=8080

# --------------------------------------------
# Configurazione Test Streams
# --------------------------------------------
# Durata registrazione video durante i test (in secondi)
RECORD_DURATION=10

