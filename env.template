# ============================================
# Reolink Baichuan test configuration
# ============================================
# Copy this file to .env and fill in your camera credentials.
#
# Copy command:
#   cp env.template .env

# --------------------------------------------
# TCP configuration (wired cameras)
# --------------------------------------------
TCP_HOST=
TCP_USERNAME=admin
TCP_PASSWORD=

# --------------------------------------------
# TCP configuration (wired cameras, H.265 validation)
# Use this if you want to validate HEVC (H.265) -> RTSP proxying end-to-end.
# --------------------------------------------
TCP265_HOST=
TCP265_USERNAME=admin
TCP265_PASSWORD=

# --------------------------------------------
# UDP configuration (BCUDP - battery cameras)
# --------------------------------------------
UDP_HOST=
UDP_USERNAME=admin
UDP_PASSWORD=
UDP_UID=

# --------------------------------------------
# NVR configuration (Home Hub)
# --------------------------------------------
NVR_HOST=
NVR_USERNAME=admin
NVR_PASSWORD=
NVR_UID=

# --------------------------------------------
# RTSP proxy server configuration
# --------------------------------------------
# Port the RTSP proxy will listen on
RTSP_PROXY_PORT=8080

# --------------------------------------------
# Stream tests
# --------------------------------------------
# Recording duration during tests (seconds)
RECORD_DURATION=10

# --------------------------------------------
# Global debug / dump flags
# --------------------------------------------
# Enable debug logs (library-wide)
# BAICHUAN_DEBUG=1
#
# Enable extra RTSP proxy/server debug logs (kept quiet by default)
# BAICHUAN_DEBUG_RTSP=1
# (Also enables verbose logs from the stream decoding/packet pipeline, e.g. BaichuanVideoStream)
#
# Trace stream commands (cmd_id 3/4): tx/rx details (msgNum, payloadOffset, lengths)
# BAICHUAN_TRACE_STREAM=1
#
# Enable dumps (library-wide)
# BAICHUAN_DUMP=1
#
# Dump output directory (defaults to ./test/frames-debug)
# BAICHUAN_DUMP_DIR=./test/frames-debug
#
# Fine-grained toggles (default to BAICHUAN_DUMP if set):
# BAICHUAN_DUMP_BCMEDIA=1
# BAICHUAN_DUMP_NALS=1

